rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for restaurant settings and menu, writes allowed for restaurant management
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
